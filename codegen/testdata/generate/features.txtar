// Code generated by gogenconf. DO NOT EDIT.

package appconfig

import gogenconf "github.com/arran4/gogenconf"

type Config struct {
	Service ServiceConfig
	Workers []WorkerConfig
}
type ServiceConfig struct {
	Endpoint string
	Secret   []byte
	Tags     []string
	Content  gogenconf.Provider[[]byte]
	Enabled  bool
}
type WorkerConfig struct {
	Name string
	Args []string
}
