// Invalid static or environment values are errors; they are never treated as omission.
func Defaults(lookup gogenconf.LookupEnv) (runtimeconfig.Config, error) {
	var c runtimeconfig.Config
	c.Service.Endpoint = "https://default.example.test"
	if lookup != nil {
		if v, ok := lookup("SERVICE_ENDPOINT"); ok && v != "" {
			c.Service.Endpoint = v
		}
	}
	c.Service.Tags = strings.FieldsFunc("one,two", func(r rune) bool { return r == ',' })
	return c, nil
}

