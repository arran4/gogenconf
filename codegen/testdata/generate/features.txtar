Case: generated mappings for defaults, environment metadata, sensitive bytes,
provider output, repeated sections, slices, InputOnly, and RuntimeOnly fields.

-- options.json --
{"scenario":"features"}
-- expected/binding/config_generated.go --
// Code generated by gogenconf. DO NOT EDIT.

package binding

import (
	"context"
	"fmt"
	gogenconf "github.com/arran4/gogenconf"
	"strings"
)
import runtimeconfig "example.test/appconfig"

var _ = strings.Join
var _ = fmt.Errorf

// Defaults returns concrete static defaults and optional legacy environment overrides.
func Defaults(lookup gogenconf.LookupEnv) runtimeconfig.Config {
	var c runtimeconfig.Config
	c.Service.Endpoint = "https://default.example.test"
	if lookup != nil {
		if v, ok := lookup("SERVICE_ENDPOINT"); ok && v != "" {
			c.Service.Endpoint = v
		}
	}
	c.Service.Tags = strings.FieldsFunc("one,two", func(r rune) bool { return r == ',' })
	return c
}

// Resolve constructs ordinary Go fields; provider policy alone defers resolution.
func Resolve(ctx context.Context, d *gogenconf.Document, r *gogenconf.Registry, lookup gogenconf.LookupEnv) (runtimeconfig.Config, error) {
	var c runtimeconfig.Config
	if d == nil {
		return c, fmt.Errorf("nil document")
	}
	if d.Version > 2 {
		return c, fmt.Errorf("unsupported future configuration version")
	}
	{
		e := gogenconf.BindingValue(d, "service", "endpoint", gogenconf.Literal{Value: "https://default.example.test"}, "SERVICE_ENDPOINT", true, lookup)
		if e != nil {
			value, err := gogenconf.ResolveField[string](ctx, r, e, "service.endpoint", false)
			if err != nil {
				return runtimeconfig.Config{}, err
			}
			c.Service.Endpoint = value
		}
	}
	{
		e := gogenconf.BindingValue(d, "service", "secret", nil, "", false, lookup)
		if e == nil {
			return runtimeconfig.Config{}, fmt.Errorf("missing required field service.secret")
		}
		if e != nil {
			value, err := gogenconf.ResolveField[[]byte](ctx, r, e, "service.secret", true)
			if err != nil {
				return runtimeconfig.Config{}, err
			}
			c.Service.Secret = value
		}
	}
	{
		e := gogenconf.BindingValue(d, "service", "tags", gogenconf.Literal{Value: "one,two"}, "", false, lookup)
		if e != nil {
			value, err := gogenconf.ResolveField[[]string](ctx, r, e, "service.tags", false)
			if err != nil {
				return runtimeconfig.Config{}, err
			}
			c.Service.Tags = value
		}
	}
	{
		e := gogenconf.BindingValue(d, "service", "content", nil, "", false, lookup)
		if e == nil {
			return runtimeconfig.Config{}, fmt.Errorf("missing required field service.content")
		}
		if e != nil {
			c.Service.Content = gogenconf.FieldProvider[[]byte](r, e, "service.content", false)
		}
	}
	for _, section := range d.Sections {
		if !strings.HasPrefix(section.Name, "worker ") {
			continue
		}
		var v runtimeconfig.WorkerConfig
		v.Name = strings.TrimPrefix(section.Name, "worker ")
		{
			e := gogenconf.BindingValue(d, section.Name, "args", gogenconf.Literal{Value: "a,b"}, "", false, lookup)
			if e != nil {
				value, err := gogenconf.ResolveField[[]string](ctx, r, e, "worker.args", false)
				if err != nil {
					return runtimeconfig.Config{}, err
				}
				v.Args = value
			}
		}
		c.Workers = append(c.Workers, v)
	}
	return c, nil
}
-- expected/model/config_generated.go --
// Code generated by gogenconf. DO NOT EDIT.

package appconfig

import gogenconf "github.com/arran4/gogenconf"

type Config struct {
	Service ServiceConfig
	Workers []WorkerConfig
}
type ServiceConfig struct {
	Endpoint string
	Secret   []byte
	Tags     []string
	Content  gogenconf.Provider[[]byte]
	Enabled  bool
}
type WorkerConfig struct {
	Name string
	Args []string
}
