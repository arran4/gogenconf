{"scenario":"basic"}
-- expected/binding/config_generated.go --
// Code generated by gogenconf. DO NOT EDIT.

package binding

import (
	"context"
	"errors"
	"fmt"
	gogenconf "github.com/arran4/gogenconf"
	"strconv"
	"strings"
)
import runtimeconfig "example.test/appconfig"

var _ = strings.Join
var _ = fmt.Errorf
var _ = errors.New
var _ = strconv.IntSize
var ErrInvalidDefault = errors.New("invalid generated default")

func defaultValueError(path string, sensitive bool, err error) error {
	if sensitive {
		return fmt.Errorf("default %s: %w", path, ErrInvalidDefault)
	}
	return fmt.Errorf("default %s: %w", path, err)
}

// Defaults returns concrete static defaults and optional legacy environment overrides.
// Invalid static or environment values are errors; they are never treated as omission.
func Defaults(lookup gogenconf.LookupEnv) (runtimeconfig.Config, error) {
	var c runtimeconfig.Config
	c.Service.Endpoint = "https://example.test"
	return c, nil
}

// Resolve constructs ordinary Go fields; provider policy alone defers resolution.
func Resolve(ctx context.Context, d *gogenconf.Document, r *gogenconf.Registry, lookup gogenconf.LookupEnv) (runtimeconfig.Config, error) {
	var c runtimeconfig.Config
	if d == nil {
		return c, fmt.Errorf("nil document")
	}
	if d.Version > 1 {
		return c, fmt.Errorf("unsupported future configuration version")
	}
	{
		e := gogenconf.BindingValue(d, "service", "endpoint", gogenconf.Literal{Value: "https://example.test"}, "", false, lookup)
		if e != nil {
			value, err := gogenconf.ResolveField[string](ctx, r, e, "service.endpoint", false)
			if err != nil {
				return runtimeconfig.Config{}, err
			}
			c.Service.Endpoint = value
		}
	}
	{
		e := gogenconf.BindingValue(d, "service", "key", nil, "", false, lookup)
		if e == nil {
			return runtimeconfig.Config{}, fmt.Errorf("missing required field service.key")
		}
		if e != nil {
			value, err := gogenconf.ResolveField[[]byte](ctx, r, e, "service.key", true)
			if err != nil {
				return runtimeconfig.Config{}, err
			}
			c.Service.Key = value
		}
	}
	return c, nil
}
