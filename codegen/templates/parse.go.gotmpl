func findOpeningBrace(line string) (string, bool, int, error) {
	n := len(line)
	inQuote := false
	escaped := false
	for i := 0; i < n; i++ {
		c := line[i]
		if inQuote {
			if escaped {
				escaped = false
				continue
			}
			if c == '\\' {
				escaped = true
				continue
			}
			if c == '"' {
				inQuote = false
			}
			continue
		}
		if c == '"' {
			inQuote = true
			continue
		}
		if c == '#' {
			// Rest of line is comment
			break
		}
		if c == '{' {
			rem := strings.TrimSpace(line[i+1:])
			if rem == "" || strings.HasPrefix(rem, "#") {
				return strings.TrimSpace(line[:i]), true, i, nil
			}
		}
	}
	if inQuote {
		return "", false, 0, errors.New("unterminated quote")
	}
	return "", false, 0, nil
}

type pathComponent struct {
	name     string
	mutation MutationKind
	col      int
	quoted   bool
}

func splitMutation(s string) (string, MutationKind, bool) {
	for _, op := range []struct {
		str  string
		kind MutationKind
	}{
		{"[+]", MutationAdd},
		{"[=]", MutationReplace},
		{"[~]", MutationMutate},
		{"[-]", MutationDelete},
	} {
		if strings.HasSuffix(s, op.str) {
			return s[:len(s)-len(op.str)], op.kind, true
		}
	}
	return s, MutationNone, false
}

func splitPrefixMutation(s string) (string, MutationKind) {
	trimmed := strings.TrimLeft(s, " \t")
	for _, op := range []struct {
		str  string
		kind MutationKind
	}{
		{"[+]", MutationAdd},
		{"[=]", MutationReplace},
		{"[~]", MutationMutate},
		{"[-]", MutationDelete},
	} {
		if strings.HasPrefix(trimmed, op.str) {
			rem := strings.TrimLeft(trimmed[len(op.str):], " \t")
			return rem, op.kind
		}
	}
	return s, MutationNone
}

func parsePathComponents(s string, startCol int) ([]pathComponent, error) {
	var comps []pathComponent
	i := 0
	n := len(s)
	for i < n {
		for i < n && (s[i] == ' ' || s[i] == '\t') {
			i++
		}
		if i >= n {
			break
		}
		col := startCol + i
		if s[i] == '"' {
			start := i
			i++
			escaped := false
			closed := false
			for i < n {
				if escaped {
					escaped = false
					i++
					continue
				}
				if s[i] == '\\' {
					escaped = true
					i++
					continue
				}
				if s[i] == '"' {
					closed = true
					i++
					break
				}
				i++
			}
			if !closed {
				return nil, fmt.Errorf("unterminated quoted path component at column %d", col)
			}
			raw := s[start:i]
			unquoted, err := strconv.Unquote(raw)
			if err != nil {
				return nil, fmt.Errorf("invalid quoted path component at column %d: %w", col, err)
			}
			var mut MutationKind
			if i+3 <= n {
				if _, m, ok := splitMutation(s[i : i+3]); ok {
					mut = m
					i += 3
				}
			}
			comps = append(comps, pathComponent{name: unquoted, mutation: mut, col: col, quoted: true})
		} else {
			start := i
			for i < n && s[i] != ' ' && s[i] != '\t' && s[i] != '{' {
				i++
			}
			raw := s[start:i]
			base, mut, hasMut := splitMutation(raw)
			if hasMut {
				if base == "" {
					return nil, fmt.Errorf("invalid path component %q at column %d", raw, col)
				}
				if !validPathComponent(base) {
					return nil, fmt.Errorf("invalid path component %q at column %d", base, col)
				}
				comps = append(comps, pathComponent{name: base, mutation: mut, col: col, quoted: false})
			} else {
				if !validPathComponent(raw) {
					return nil, fmt.Errorf("invalid path component %q at column %d", raw, col)
				}
				comps = append(comps, pathComponent{name: raw, mutation: MutationNone, col: col, quoted: false})
			}
		}
	}
	return comps, nil
}

func validPathComponent(s string) bool {
	if s == "" {
		return false
	}
	for i, c := range []byte(s) {
		if !(c == '_' || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || i > 0 && (c >= '0' && c <= '9' || c == '-' || c == '.' || c == '/')) {
			return false
		}
	}
	return true
}

func identifier(s string) bool {
	if s == "" {
		return false
	}
	for i, c := range []byte(s) {
		if !(c == '_' || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || i > 0 && (c >= '0' && c <= '9' || c == '-' || c == '.')) {
			return false
		}
	}
	return true
}

func validIdentity(s string) bool {
	if s == "" {
		return false
	}
	for i, c := range []byte(s) {
		if !(c == '_' || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || i > 0 && (c >= '0' && c <= '9' || c == '-' || c == '.' || c == '/')) {
			return false
		}
	}
	return true
}

// ParseExpr parses a literal or a nested declarer expression.
func ParseExpr(input string) (Expr, error) {
	return ParseExprWithSpan(input, Span{})
}

// ParseExprWithSpan parses a literal or a nested declarer expression, attaching source span metadata.
func ParseExprWithSpan(input string, base Span) (Expr, error) {
	trimmed := strings.TrimSpace(input)
	leadingSpace := len(input) - len(strings.TrimLeft(input, " \t\r\n"))
	startCol := base.Column
	if startCol > 0 {
		startCol += leadingSpace
	}
	startOffset := base.Offset
	if startOffset > 0 || base.Line > 0 {
		startOffset += leadingSpace
	}
	p := exprParser{
		input:       trimmed,
		baseSource:  base.Source,
		baseLine:    base.Line,
		startCol:    startCol,
		startOffset: startOffset,
	}
	if p.input == "" {
		return Literal{
			Span: Span{
				Source: base.Source,
				Line:   base.Line,
				Column: startCol,
				Offset: startOffset,
			},
			Origin: OriginAuthored,
		}, nil
	}
	e, err := p.parseExpr(false)
	if err != nil {
		return nil, err
	}
	p.space()
	if p.pos != len(p.input) {
		return nil, fmt.Errorf("unexpected token at byte %d", p.pos)
	}
	return e, nil
}

type exprParser struct {
	input       string
	pos         int
	depth       int
	baseSource  string
	baseLine    int
	startCol    int
	startOffset int
}

func (p *exprParser) spanAt(startPos int) Span {
	col := 0
	if p.startCol > 0 {
		col = p.startCol + startPos
	}
	off := 0
	if p.startOffset > 0 || p.baseLine > 0 {
		off = p.startOffset + startPos
	}
	return Span{
		Source: p.baseSource,
		Line:   p.baseLine,
		Column: col,
		Offset: off,
	}
}

func (p *exprParser) space() {
	for p.pos < len(p.input) && unicode.IsSpace(rune(p.input[p.pos])) {
		p.pos++
	}
}

func (p *exprParser) parseExpr(argument bool) (Expr, error) {
	if p.depth > 64 {
		return nil, fmt.Errorf("expression nesting exceeds 64 levels")
	}
	p.space()
	if p.pos >= len(p.input) {
		return Literal{Span: p.spanAt(p.pos), Origin: OriginAuthored}, nil
	}
	if p.input[p.pos] == '"' {
		return p.quoted()
	}
	start := p.pos
	for p.pos < len(p.input) && isIdent(p.input[p.pos]) {
		p.pos++
	}
	if p.pos > start {
		name := p.input[start:p.pos]
		p.space()
		if p.pos < len(p.input) && p.input[p.pos] == '(' {
			if !identifier(name) {
				return nil, fmt.Errorf("invalid declarer identifier")
			}
			p.depth++
			defer func() { p.depth-- }()
			p.pos++
			var args []Expr
			p.space()
			if p.pos < len(p.input) && p.input[p.pos] == ')' {
				p.pos++
				return Call{Name: name, Span: p.spanAt(start), Origin: OriginAuthored}, nil
			}
			for {
				if p.pos >= len(p.input) || p.input[p.pos] == ',' || p.input[p.pos] == ')' {
					return nil, fmt.Errorf("missing call argument")
				}
				a, err := p.parseExpr(true)
				if err != nil {
					return nil, err
				}
				args = append(args, a)
				p.space()
				if p.pos >= len(p.input) {
					return nil, fmt.Errorf("unterminated call")
				}
				if p.input[p.pos] == ')' {
					p.pos++
					return Call{Name: name, Args: args, Span: p.spanAt(start), Origin: OriginAuthored}, nil
				}
				if p.input[p.pos] != ',' {
					return nil, fmt.Errorf("expected comma or closing parenthesis at byte %d", p.pos)
				}
				p.pos++
				p.space()
			}
		}
		// It is a literal, not a call. Consume only this argument, leaving an
		// enclosing comma or closing parenthesis for its caller.
		p.pos = start
	}
	// A bare literal owns the remaining top-level source, or up to an enclosing
	// call delimiter when it is an argument.
	valueStart := p.pos
	for p.pos < len(p.input) {
		c := p.input[p.pos]
		if argument && (c == ',' || c == ')') {
			break
		}
		if c == '(' || c == ')' || c == '"' {
			return nil, fmt.Errorf("quote literal punctuation at byte %d", p.pos)
		}
		p.pos++
	}
	v := strings.TrimSpace(p.input[valueStart:p.pos])
	return Literal{Value: v, Span: p.spanAt(valueStart), Origin: OriginAuthored}, nil
}

func (p *exprParser) quoted() (Expr, error) {
	start := p.pos
	p.pos++
	for p.pos < len(p.input) {
		if p.input[p.pos] == '\\' {
			p.pos += 2
			continue
		}
		if p.input[p.pos] == '"' {
			p.pos++
			raw := p.input[start:p.pos]
			v, err := strconv.Unquote(raw)
			if err != nil {
				return nil, fmt.Errorf("invalid quoted escape at byte %d", start)
			}
			return Literal{Value: v, Span: p.spanAt(start), Origin: OriginAuthored}, nil
		}
		p.pos++
	}
	return nil, fmt.Errorf("unterminated quoted literal")
}

func isIdent(b byte) bool {
	return b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z' || b >= '0' && b <= '9' || b == '_' || b == '-'
}
